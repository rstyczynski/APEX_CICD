        <mxCell id="flow13" source="step13" target="step14" value="" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=14;labelBackgroundColor=#ffffff;strokeColor=#475569;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="step15" value="15. Finish D&#10;Return to CLI; press key → PASS result stage D_integration_test.&#10;Next: E promotes the same qualified archive to user_acceptance_test." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Helvetica;fontSize=16;strokeColor=#334155;fillColor=#ffffff;fillColor=#eff6ff;fontSize=15;" link="cicd-walkthrough.md#d-qualify-the-initial-release">
          <mxGeometry x="830" y="940" width="725" height="90" as="geometry" />
        </mxCell>
        <mxCell id="flow14" source="step14" target="step15" value="" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=14;labelBackgroundColor=#ffffff;strokeColor=#475569;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="start" source="dactor" target="step1" value="executes" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=14;labelBackgroundColor=#ffffff;strokeColor=#475569;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="turn" source="step8" target="step9" value="continue" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=14;labelBackgroundColor=#ffffff;strokeColor=#475569;exitX=1;exitY=0.5;entryX=0;entryY=0.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="dfail" value="FAILURE RULE: any unexpected operation failure stops D and retains the attempt for inspection. No automatic reset or user_acceptance_test promotion.&#10;All archive operations recheck identity/environment and use verified archive SQL. --rehearse substitutes runtime API examples; no browser acceptance claimed.&#10;Source: cicd-walkthrough-D_integration_test.sh → initial_install() → cicd-release-step.sh / cicd-release-result.sh. Exact actions: main walkthrough D." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Helvetica;fontSize=16;strokeColor=#334155;fillColor=#ffffff;strokeColor=none;fontSize=14;" link="cicd-walkthrough.md#d-qualify-the-initial-release">
          <mxGeometry x="25" y="1190" width="1550" height="65" as="geometry" />
