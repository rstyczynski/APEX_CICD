  <diagram id="e1-D-qualification" name="D integration_test">
    <mxGraphModel dx="1600" dy="1270" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1600" pageHeight="1270" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="dtitle" value="D — Qualify initial 1.0.0 archive in integration_test / E1_INTEGRATION / application 810004" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Helvetica;fontSize=16;strokeColor=#334155;fillColor=#ffffff;strokeColor=none;fontSize=23;fontStyle=1;">
          <mxGeometry x="20" y="15" width="1560" height="55" as="geometry" />
        </mxCell>
        <mxCell id="dactor" value="Deployer&#10;A-03" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Helvetica;fontSize=16;strokeColor=#334155;fillColor=#ffffff;shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;fillColor=none;" link="../../docs/srs.md#actors">
          <mxGeometry x="50" y="105" width="60" height="85" as="geometry" />
        </mxCell>
        <mxCell id="dscope" value="Runs the CLI steps and browser checkpoints. Switches to VERIFIER and LAB_USER runtime accounts when prompted.&#10;UC-4 delivery; UC-11 verification support; UC-2/3 runtime behavior. PBI-011.6 / PBI-011; evidence PBI-012.&#10;D qualifies an existing archive. It does not export C, rebuild the archive, promote user_acceptance_test or copy developer data." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Helvetica;fontSize=16;strokeColor=#334155;fillColor=#ffffff;fillColor=#f1f5f9;" link="sprint_E.1_design.md#pbi-0116--qualify-and-promote-identical-artifacts">
          <mxGeometry x="180" y="95" width="1370" height="115" as="geometry" />
        </mxCell>
        <mxCell id="step1" value="1. Prerequisites&#10;Require C_world.done; create a new D attempt directory." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Helvetica;fontSize=16;strokeColor=#334155;fillColor=#ffffff;fillColor=#eff6ff;fontSize=15;" link="cicd-walkthrough.md#d-qualify-the-initial-release">
          <mxGeometry x="35" y="250" width="725" height="90" as="geometry" />
        </mxCell>
        <mxCell id="step2" value="2. Select + inspect archive&#10;initial-selected.txt → immutable reviewed 1.0.0 archive.&#10;Check SHA-256, members, manifest and source/candidate identity." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Helvetica;fontSize=16;strokeColor=#334155;fillColor=#ffffff;fillColor=#eff6ff;fontSize=15;" link="cicd-walkthrough.md#d-qualify-the-initial-release">
          <mxGeometry x="35" y="365" width="725" height="90" as="geometry" />
        </mxCell>
        <mxCell id="flow1" source="step1" target="step2" value="" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=14;labelBackgroundColor=#ffffff;strokeColor=#475569;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="step3" value="3. Read status&#10;Archive controller: status. Read current integration_test epoch." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Helvetica;fontSize=16;strokeColor=#334155;fillColor=#ffffff;fillColor=#eff6ff;fontSize=15;" link="cicd-walkthrough.md#d-qualify-the-initial-release">
          <mxGeometry x="35" y="480" width="725" height="90" as="geometry" />
        </mxCell>
        <mxCell id="flow2" source="step2" target="step3" value="" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=14;labelBackgroundColor=#ffffff;strokeColor=#475569;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="step4" value="4. Admit empty target&#10;Prompt → admit with expected epoch.&#10;Record ownership/attempt; advance epoch; runtime remains gated." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Helvetica;fontSize=16;strokeColor=#334155;fillColor=#ffffff;fillColor=#eff6ff;fontSize=15;" link="cicd-walkthrough.md#d-qualify-the-initial-release">
          <mxGeometry x="35" y="595" width="725" height="90" as="geometry" />
        </mxCell>
        <mxCell id="flow3" source="step3" target="step4" value="" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=14;labelBackgroundColor=#ffffff;strokeColor=#475569;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="step5" value="5. Migrate&#10;Prompt → migrate. SQLcl Liquibase validate → update → status.&#10;Initial archive migrations 001–004, not checkout patch migrations." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Helvetica;fontSize=16;strokeColor=#334155;fillColor=#ffffff;fillColor=#eff6ff;fontSize=15;" link="cicd-walkthrough.md#d-qualify-the-initial-release">
          <mxGeometry x="35" y="710" width="725" height="90" as="geometry" />
        </mxCell>
        <mxCell id="flow4" source="step4" target="step5" value="" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=14;labelBackgroundColor=#ffffff;strokeColor=#475569;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="step6" value="6. Import&#10;Prompt → import native split source into app 810004.&#10;Map E1_INTEGRATION; assert ordinary runtime is still blocked." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Helvetica;fontSize=16;strokeColor=#334155;fillColor=#ffffff;fillColor=#eff6ff;fontSize=15;" link="cicd-walkthrough.md#d-qualify-the-initial-release">
          <mxGeometry x="35" y="825" width="725" height="90" as="geometry" />
        </mxCell>
        <mxCell id="flow5" source="step5" target="step6" value="" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=14;labelBackgroundColor=#ffffff;strokeColor=#475569;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="step7" value="7. Units + integrity&#10;Prompt → units. Versions/pages/compilation, composition/history.&#10;Transactional unit fixtures roll back." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Helvetica;fontSize=16;strokeColor=#334155;fillColor=#ffffff;fillColor=#eff6ff;fontSize=15;" link="cicd-walkthrough.md#d-qualify-the-initial-release">
          <mxGeometry x="35" y="940" width="725" height="90" as="geometry" />
        </mxCell>
        <mxCell id="flow6" source="step6" target="step7" value="" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=14;labelBackgroundColor=#ffffff;strokeColor=#475569;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="step8" value="8. Enable verification&#10;Prompt → verify. Integrity + no packaged business data.&#10;Allow VERIFIER; mark attempt verifying. Browser test is next." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Helvetica;fontSize=16;strokeColor=#334155;fillColor=#ffffff;fillColor=#eff6ff;fontSize=15;" link="cicd-walkthrough.md#d-qualify-the-initial-release">
          <mxGeometry x="35" y="1055" width="725" height="90" as="geometry" />
        </mxCell>
        <mxCell id="flow7" source="step7" target="step8" value="" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=14;labelBackgroundColor=#ffffff;strokeColor=#475569;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="step9" value="9. Retrieve VERIFIER password&#10;Second terminal: python3 scripts/cicd-password.py VERIFIER" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Helvetica;fontSize=16;strokeColor=#334155;fillColor=#ffffff;fillColor=#eff6ff;fontSize=15;" link="cicd-walkthrough.md#d-qualify-the-initial-release">
          <mxGeometry x="830" y="250" width="725" height="90" as="geometry" />
        </mxCell>
        <mxCell id="step10" value="10. Browser as VERIFIER&#10;integration_test URL: create Hello/World, configure defaults,&#10;save Hello World and refresh history. Leave CLI waiting." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Helvetica;fontSize=16;strokeColor=#334155;fillColor=#ffffff;fillColor=#dcfce7;fontSize=15;" link="cicd-walkthrough.md#d-qualify-the-initial-release">
          <mxGeometry x="830" y="365" width="725" height="90" as="geometry" />
        </mxCell>
        <mxCell id="flow9" source="step9" target="step10" value="" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=14;labelBackgroundColor=#ffffff;strokeColor=#475569;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="step11" value="11. Publish integration_test&#10;Continue CLI. Require saved VERIFIER snapshot; prepare native&#10;availability; fingerprint; commit ready gate + success receipt." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Helvetica;fontSize=16;strokeColor=#334155;fillColor=#ffffff;fillColor=#eff6ff;fontSize=15;" link="cicd-walkthrough.md#d-qualify-the-initial-release">
          <mxGeometry x="830" y="480" width="725" height="90" as="geometry" />
        </mxCell>
        <mxCell id="flow10" source="step10" target="step11" value="" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=14;labelBackgroundColor=#ffffff;strokeColor=#475569;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="step12" value="12. Check result&#10;Ready state, versions, same archive hash and matching live&#10;fingerprint. Mark D complete only after result succeeds." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Helvetica;fontSize=16;strokeColor=#334155;fillColor=#ffffff;fillColor=#eff6ff;fontSize=15;" link="cicd-walkthrough.md#d-qualify-the-initial-release">
          <mxGeometry x="830" y="595" width="725" height="90" as="geometry" />
        </mxCell>
        <mxCell id="flow11" source="step11" target="step12" value="" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=14;labelBackgroundColor=#ffffff;strokeColor=#475569;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="step13" value="13. Retrieve LAB_USER password&#10;Second terminal: python3 scripts/cicd-password.py LAB_USER" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Helvetica;fontSize=16;strokeColor=#334155;fillColor=#ffffff;fillColor=#eff6ff;fontSize=15;" link="cicd-walkthrough.md#d-qualify-the-initial-release">
          <mxGeometry x="830" y="710" width="725" height="90" as="geometry" />
        </mxCell>
        <mxCell id="flow12" source="step12" target="step13" value="" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=14;labelBackgroundColor=#ffffff;strokeColor=#475569;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="step14" value="14. Browser as LAB_USER&#10;Sign out of VERIFIER; use integration_test app; create a greeting&#10;and refresh history. Confirm ordinary access after publication." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Helvetica;fontSize=16;strokeColor=#334155;fillColor=#ffffff;fillColor=#dcfce7;fontSize=15;" link="cicd-walkthrough.md#d-qualify-the-initial-release">
