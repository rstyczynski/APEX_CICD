        </mxCell>
        <mxCell id="step2" link="cicd-walkthrough.md#d-qualify-the-initial-release" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Helvetica;fontSize=16;strokeColor=#334155;fillColor=#ffffff;fillColor=#eff6ff;fontSize=15;" value="2. Select + inspect archive&#xa;initial-selected.txt → immutable reviewed 1.0.0 archive.&#xa;Check SHA-256, members, manifest and source/candidate identity." vertex="1">
          <mxGeometry height="90" width="725" x="35" y="365" as="geometry" />
        </mxCell>
        <mxCell id="flow1" edge="1" parent="1" source="step1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=14;labelBackgroundColor=#ffffff;strokeColor=#475569;" target="step2" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="step3" link="cicd-walkthrough.md#d-qualify-the-initial-release" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Helvetica;fontSize=16;strokeColor=#334155;fillColor=#ffffff;fillColor=#eff6ff;fontSize=15;" value="3. Read status&#xa;Archive controller: status. Read current integration_test epoch." vertex="1">
          <mxGeometry height="90" width="725" x="35" y="480" as="geometry" />
        </mxCell>
        <mxCell id="flow2" edge="1" parent="1" source="step2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=14;labelBackgroundColor=#ffffff;strokeColor=#475569;" target="step3" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="step4" link="cicd-walkthrough.md#d-qualify-the-initial-release" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Helvetica;fontSize=16;strokeColor=#334155;fillColor=#ffffff;fillColor=#eff6ff;fontSize=15;" value="4. Admit empty target&#xa;Prompt → admit with expected epoch.&#xa;Record ownership/attempt; advance epoch; runtime remains gated." vertex="1">
          <mxGeometry height="90" width="725" x="35" y="595" as="geometry" />
        </mxCell>
        <mxCell id="flow3" edge="1" parent="1" source="step3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=14;labelBackgroundColor=#ffffff;strokeColor=#475569;" target="step4" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="step5" link="cicd-walkthrough.md#d-qualify-the-initial-release" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Helvetica;fontSize=16;strokeColor=#334155;fillColor=#ffffff;fillColor=#eff6ff;fontSize=15;" value="5. Migrate&#xa;Prompt → migrate. SQLcl Liquibase validate → update → status.&#xa;Initial archive migrations 001–004, not checkout patch migrations." vertex="1">
          <mxGeometry height="90" width="725" x="35" y="710" as="geometry" />
        </mxCell>
        <mxCell id="flow4" edge="1" parent="1" source="step4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=14;labelBackgroundColor=#ffffff;strokeColor=#475569;" target="step5" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="step6" link="cicd-walkthrough.md#d-qualify-the-initial-release" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Helvetica;fontSize=16;strokeColor=#334155;fillColor=#ffffff;fillColor=#eff6ff;fontSize=15;" value="6. Import&#xa;Prompt → import native split source into app 810004.&#xa;Map E1_INTEGRATION; assert ordinary runtime is still blocked." vertex="1">
          <mxGeometry height="90" width="725" x="35" y="825" as="geometry" />
        </mxCell>
        <mxCell id="flow5" edge="1" parent="1" source="step5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=14;labelBackgroundColor=#ffffff;strokeColor=#475569;" target="step6" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="step7" link="cicd-walkthrough.md#d-qualify-the-initial-release" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Helvetica;fontSize=16;strokeColor=#334155;fillColor=#ffffff;fillColor=#eff6ff;fontSize=15;" value="7. Units + integrity&#xa;Prompt → units. Versions/pages/compilation, composition/history.&#xa;Transactional unit fixtures roll back." vertex="1">
          <mxGeometry height="90" width="725" x="35" y="940" as="geometry" />
        </mxCell>
        <mxCell id="flow6" edge="1" parent="1" source="step6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=14;labelBackgroundColor=#ffffff;strokeColor=#475569;" target="step7" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="step8" link="cicd-walkthrough.md#d-qualify-the-initial-release" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Helvetica;fontSize=16;strokeColor=#334155;fillColor=#ffffff;fillColor=#eff6ff;fontSize=15;" value="8. Enable verification&#xa;Prompt → verify. Integrity + no packaged business data.&#xa;Allow VERIFIER; mark attempt verifying. Browser test is next." vertex="1">
          <mxGeometry height="90" width="725" x="35" y="1055" as="geometry" />
        </mxCell>
        <mxCell id="flow7" edge="1" parent="1" source="step7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=14;labelBackgroundColor=#ffffff;strokeColor=#475569;" target="step8" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="step9" link="cicd-walkthrough.md#d-qualify-the-initial-release" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Helvetica;fontSize=16;strokeColor=#334155;fillColor=#ffffff;fillColor=#eff6ff;fontSize=15;" value="9. Retrieve VERIFIER password&#xa;Second terminal: python3 scripts/cicd-password.py VERIFIER" vertex="1">
          <mxGeometry height="90" width="725" x="830" y="250" as="geometry" />
        </mxCell>
        <mxCell id="step10" link="cicd-walkthrough.md#d-qualify-the-initial-release" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Helvetica;fontSize=16;strokeColor=#334155;fillColor=#ffffff;fillColor=#dcfce7;fontSize=15;" value="10. Browser as VERIFIER&#xa;integration_test URL: create Hello/World, configure defaults,&#xa;save Hello World and refresh history. Leave CLI waiting." vertex="1">
          <mxGeometry height="90" width="725" x="830" y="365" as="geometry" />
        </mxCell>
        <mxCell id="flow9" edge="1" parent="1" source="step9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=14;labelBackgroundColor=#ffffff;strokeColor=#475569;" target="step10" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="step11" link="cicd-walkthrough.md#d-qualify-the-initial-release" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Helvetica;fontSize=16;strokeColor=#334155;fillColor=#ffffff;fillColor=#eff6ff;fontSize=15;" value="11. Publish integration_test&#xa;Continue CLI. Require saved VERIFIER snapshot; prepare native&#xa;availability; fingerprint; commit ready gate + success receipt." vertex="1">
          <mxGeometry height="90" width="725" x="830" y="480" as="geometry" />
        </mxCell>
        <mxCell id="flow10" edge="1" parent="1" source="step10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=14;labelBackgroundColor=#ffffff;strokeColor=#475569;" target="step11" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="step12" link="cicd-walkthrough.md#d-qualify-the-initial-release" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Helvetica;fontSize=16;strokeColor=#334155;fillColor=#ffffff;fillColor=#eff6ff;fontSize=15;" value="12. Check result&#xa;Ready state, versions, same archive hash and matching live&#xa;fingerprint. Mark D complete only after result succeeds." vertex="1">
          <mxGeometry height="90" width="725" x="830" y="595" as="geometry" />
        </mxCell>
        <mxCell id="flow11" edge="1" parent="1" source="step11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=14;labelBackgroundColor=#ffffff;strokeColor=#475569;" target="step12" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="step13" link="cicd-walkthrough.md#d-qualify-the-initial-release" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Helvetica;fontSize=16;strokeColor=#334155;fillColor=#ffffff;fillColor=#eff6ff;fontSize=15;" value="13. Retrieve LAB_USER password&#xa;Second terminal: python3 scripts/cicd-password.py LAB_USER" vertex="1">
          <mxGeometry height="90" width="725" x="830" y="710" as="geometry" />
        </mxCell>
        <mxCell id="flow12" edge="1" parent="1" source="step12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=14;labelBackgroundColor=#ffffff;strokeColor=#475569;" target="step13" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="step14" link="cicd-walkthrough.md#d-qualify-the-initial-release" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Helvetica;fontSize=16;strokeColor=#334155;fillColor=#ffffff;fillColor=#dcfce7;fontSize=15;" value="14. Browser as LAB_USER&#xa;Sign out of VERIFIER; use integration_test app; create a greeting&#xa;and refresh history. Confirm ordinary access after publication." vertex="1">
          <mxGeometry height="90" width="725" x="830" y="825" as="geometry" />
        </mxCell>
        <mxCell id="flow13" edge="1" parent="1" source="step13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=14;labelBackgroundColor=#ffffff;strokeColor=#475569;" target="step14" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="step15" link="cicd-walkthrough.md#d-qualify-the-initial-release" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fontFamily=Helvetica;fontSize=16;strokeColor=#334155;fillColor=#ffffff;fillColor=#eff6ff;fontSize=15;" value="15. Finish D&#xa;Return to CLI; press key → PASS result stage D_integration_test.&#xa;Next: E promotes the same qualified archive to user_acceptance_test." vertex="1">
          <mxGeometry height="90" width="725" x="830" y="940" as="geometry" />
        </mxCell>
        <mxCell id="flow14" edge="1" parent="1" source="step14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=14;labelBackgroundColor=#ffffff;strokeColor=#475569;" target="step15" value="">
