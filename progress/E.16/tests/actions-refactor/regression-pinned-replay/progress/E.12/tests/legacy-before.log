istory(id,message) values(p_id,greet(p_name)); end;

end;
procedure		hello(p_id number) as n number; begin E12_RUN_29333.foun
dation.save(p_id,'Hello'); select count(*) into n from E12_RUN_29333.history whe
re id=p_id; if n<>1 then raise_application_error(-20001,'missing Hello'); end if
; end;

